{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tenstorrent/tt-transformers/qualification/schemas/support-manifest.schema.json",
  "title": "TT Transformers model support manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "status",
    "software",
    "hardware",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "hf_id", "hf_revision"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "hf_id": {"type": "string", "minLength": 1},
        "hf_revision": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["qualified", "experimental", "deprecated", "legacy"]},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tt_transformers", "ttnn", "python", "torch", "transformers"],
      "properties": {
        "tt_transformers": {"type": "string", "minLength": 1},
        "ttnn": {"type": "string", "minLength": 1},
        "python": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "torch": {"type": "string", "minLength": 1},
        "transformers": {"type": "string", "minLength": 1}
      }
    },
    "hardware": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["architecture", "sku", "mesh", "tp", "dp"],
        "properties": {
          "architecture": {"enum": ["wormhole", "blackhole"]},
          "sku": {"type": "string", "minLength": 1},
          "mesh": {"type": "string", "minLength": 1},
          "tp": {"type": "integer", "minimum": 1},
          "dp": {"type": "integer", "minimum": 1}
        }
      }
    },
    "limits": {"type": "object"},
    "features": {"type": "object"},
    "assets": {"type": "object"},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "git_sha", "evidence"],
      "properties": {
        "date": {"type": ["string", "null"], "format": "date"},
        "git_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
