{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependency-lock-evidence.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "indexes", "policy", "locks"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["resolver_complete_install_pending", "strict_installs_pass"]},
    "indexes": {
      "type": "object",
      "required": ["primary", "supplemental"],
      "properties": {
        "primary": {"const": "https://pypi.org/simple"},
        "supplemental": {"const": "https://download.pytorch.org/whl/cpu"}
      },
      "additionalProperties": false
    },
    "policy": {"type": "object"},
    "locks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["target", "python", "group", "lock_path", "lock_sha256", "package_count", "requested_requirements", "resolver_report", "packages", "strict_install_validation"],
        "properties": {
          "target": {"enum": ["base-py310", "host-py310", "qualification-py310", "build-dev-py310", "base-py312", "host-py312", "qualification-py312", "build-dev-py312"]},
          "python": {"enum": ["3.10.19", "3.12.13"]},
          "group": {"enum": ["base", "host", "qualification", "build-dev"]},
          "lock_path": {"type": "string"},
          "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "package_count": {"type": "integer", "minimum": 1},
          "requested_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "resolver_report": {"type": "object"},
          "packages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "version", "filename", "url", "index", "sha256", "requested"],
              "properties": {
                "name": {"type": "string"},
                "version": {"type": "string"},
                "filename": {"type": "string", "pattern": "\\.whl$"},
                "url": {"type": "string", "pattern": "^https://"},
                "index": {"enum": ["pypi", "pytorch_cpu"]},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "requested": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "strict_install_validation": {"type": ["object", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
