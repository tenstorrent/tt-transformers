{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTNN developer runtime manifest",
  "type": "object",
  "required": ["schema_version", "mode", "fingerprint", "metal", "python", "recipe", "ttnn", "toolchain", "dependencies", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["source", "wheel"]},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "metal": {"type": "object", "required": ["sha"], "properties": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "python": {"type": "object", "required": ["abi", "minor"], "properties": {"minor": {"enum": ["3.10", "3.12"]}, "abi": {"type": "string"}}},
    "recipe": {"type": "object", "required": ["name"]},
    "ttnn": {"type": "object", "required": ["version"], "properties": {"version": {"type": "string", "minLength": 1}, "wheel": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "toolchain": {"type": "object", "required": ["compiler_sha256"], "properties": {"compiler_sha256": {"$ref": "#/$defs/sha256"}, "archive": {"type": "string"}}},
    "dependencies": {
      "type": "object", "required": ["directory", "extras", "requirements"],
      "properties": {"directory": {"type": "string"}, "extras": {"type": "array", "items": {"type": "string"}}, "requirements": {"type": "array", "items": {"type": "string"}}}
    },
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "source": {"type": "object", "required": ["checkout", "build_dir", "native_fingerprint", "outputs"], "properties": {"checkout": {"type": "string"}, "build_dir": {"type": "string"}, "native_fingerprint": {"$ref": "#/$defs/sha256"}, "outputs": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}}}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "source"}}}, "then": {"required": ["source"]}},
    {"if": {"properties": {"mode": {"const": "wheel"}}}, "then": {"properties": {"ttnn": {"required": ["wheel", "sha256"]}, "toolchain": {"required": ["archive"]}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
